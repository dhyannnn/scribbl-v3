{
  "name": "scribbl",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @scribbl/web",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @scribbl/web",
    "start": "prisma migrate deploy && npm run start:web",
    "start:web": "npm run start --workspace @scribbl/web",
    "dev:mobile": "npm run start --workspace @scribbl/mobile",
    "start:mobile": "npm run start --workspace @scribbl/mobile",
    "ios:mobile": "npm run ios --workspace @scribbl/mobile",
    "android:mobile": "npm run android --workspace @scribbl/mobile",
    "web:mobile": "npm run web --workspace @scribbl/mobile",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "playwright:install": "playwright install chromium",
    "test": "npm run test:web",
    "test:web": "npm run test --workspace @scribbl/web",
    "test:watch": "npm run test:watch --workspace @scribbl/web",
    "test:coverage": "npm run test:coverage --workspace @scribbl/web",
    "lint": "npm run lint:web && npm run lint:mobile",
    "lint:web": "npm run lint --workspace @scribbl/web",
    "lint:mobile": "npm run lint --workspace @scribbl/mobile",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:web": "npm run typecheck --workspace @scribbl/web",
    "typecheck:mobile": "npm run typecheck --workspace @scribbl/mobile"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "prisma": "^7.8.0",
    "typescript": "^5"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  // Account
  ACCOUNT_DELETED

  // Workspace membership
  MEMBER_INVITED
  MEMBER_INVITE_RESENT
  MEMBER_INVITE_REVOKED
  MEMBER_INVITE_ACCEPTED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  OWNERSHIP_TRANSFERRED

  // Meeting
  MEETING_SCHEDULED
  MEETING_UPDATED
  MEETING_CANCELED

  // Recording
  RECORDING_STARTED
  RECORDING_STOPPED
  RECORDING_COMPLETED
  RECORDING_FAILED

  // Note
  NOTE_DELETED

  // File
  FILE_DELETED

  // Billing
  BILLING_UPGRADED
  BILLING_CANCELED
  BILLING_PAYMENT_FAILED
  BILLING_OVERAGE_CHARGED

  // Groups
  GROUP_CREATED
  GROUP_DELETED
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_REMOVED
}

enum WorkspaceType {
  TEAM
  PROJECT
  CLASS
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ChannelType {
  CHAT
  ANNOUNCEMENT
  DIRECT
}

enum NoteType {
  TEXT
  WHITEBOARD
}

enum NoteStorageType {
  JSON
  FILE
}

enum NoteVisibility {
  /// Only the owner can see the note.
  PRIVATE
  /// Active workspace members can see the note.
  WORKSPACE_SHARED
}

enum NoteCollaborationMode {
  /// Only the owner can edit. Workspace-shared SOLO notes are view-only for other members.
  SOLO
  /// Active workspace members can edit.
  COLLABORATIVE
}

enum NoteSourceDevice {
  WEB
  TABLET
  IPAD
  UNKNOWN
}

enum NotePermission {
  VIEW
  COMMENT
  EDIT
}

enum NoteExportAccess {
  /// Only the note owner plus workspace owners/admins can export workspace-shared notes.
  OWNER_ADMIN_AND_CREATOR
  /// Any active workspace member who can view the note can export it.
  WORKSPACE_MEMBERS
}

enum MeetingParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum MeetingArtifactType {
  NOTE
  WHITEBOARD
  PDF
  RECORDING
  FILE
}

enum MeetingArtifactSource {
  ATTACHED
  CREATED_IN_MEETING
}

enum MeetingRecordingStatus {
  STARTING
  ACTIVE
  STOPPING
  COMPLETED
  FAILED
}

enum MeetingPermissionTargetType {
  SHARED_NOTES
  WHITEBOARD
  MICROPHONE
  CAMERA
  SCREEN_SHARE
}

enum MeetingPermissionState {
  ALLOWED
  DENIED
  REQUESTED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum FileVisibility {
  PRIVATE
  WORKSPACE_SHARED
}

enum UserRole {
  STUDENT
  EDUCATOR
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PRO
  INSTITUTION
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum NotificationType {
  ANNOUNCEMENT_POSTED
  CHAT_MESSAGE
  MEETING_SCHEDULED
  MEETING_UPDATED
  MEETING_CANCELED
  FILE_SHARED
  NOTE_SHARED
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  authUserId          String?   @unique
  email               String    @unique
  firstName           String    @default("")
  lastName            String    @default("")
  displayName         String
  role                UserRole  @default(STUDENT)
  avatarUrl           String?
  institution         String?
  jobTitle            String?
  bio                 String?
  timezone            String    @default("UTC")
  language            String    @default("en")
  darkMode            Boolean   @default(false)
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdWorkspaces         Workspace[]                 @relation("WorkspaceCreator")
  ownedOrganizations        Organization[]              @relation("OrganizationOwner")
  groupMemberships          GroupMember[]
  memberships               WorkspaceMember[]
  createdChannels           Channel[]                   @relation("ChannelCreator")
  dmChannelsAsUser1         Channel[]                   @relation("DmUser1")
  dmChannelsAsUser2         Channel[]                   @relation("DmUser2")
  sentMessages              Message[]
  messageReactions          MessageReaction[]
  ownedNotes                Note[]
  noteShares                NoteCollaborator[]
  uploadedFiles             File[]
  createdMeetings           Meeting[]                   @relation("MeetingCreator")
  meetingInvites            MeetingParticipant[]
  meetingVideoSessions      MeetingVideoSession[]
  meetingArtifacts          MeetingArtifact[]
  startedRecordings         MeetingRecording[]          @relation("MeetingRecordingStarter")
  stoppedRecordings         MeetingRecording[]          @relation("MeetingRecordingStopper")
  meetingPermissions        MeetingPermissionOverride[] @relation("MeetingPermissionUser")
  grantedMeetingPermissions MeetingPermissionOverride[] @relation("MeetingPermissionGrantor")
  sentWorkspaceInvites      WorkspaceInvite[]           @relation("WorkspaceInviteInviter")
  notifications             Notification[]              @relation("UserNotifications")
  actedNotifications         Notification[]              @relation("NotificationActor")
  notificationPreference     NotificationPreference?
  auditLogs                 AuditLog[]
}

model Workspace {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  type            WorkspaceType
  description     String?
  plan            SubscriptionPlan @default(FREE)
  organizationId  String?          @db.Uuid
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy    User          @relation("WorkspaceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  members       WorkspaceMember[]
  channels      Channel[]
  notes         Note[]
  files         File[]
  meetings      Meeting[]
  invites       WorkspaceInvite[]
  notifications Notification[]
  groups        Group[]
  subscription  Subscription?

  @@index([organizationId])
}

model WorkspaceInvite {
  id              String                @id @default(uuid()) @db.Uuid
  workspaceId     String                @db.Uuid
  email           String
  role            WorkspaceRole
  token           String                @unique
  status          WorkspaceInviteStatus @default(PENDING)
  invitedByUserId String                @db.Uuid
  acceptedAt      DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId, status])
}

model WorkspaceMember {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Channel {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @db.Uuid
  meetingId       String?     @unique @db.Uuid
  name            String
  type            ChannelType @default(CHAT)
  createdByUserId String      @db.Uuid
  dmUser1Id       String?     @db.Uuid
  dmUser2Id       String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meeting   Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ChannelCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  dmUser1   User?     @relation("DmUser1", fields: [dmUser1Id], references: [id], onDelete: SetNull)
  dmUser2   User?     @relation("DmUser2", fields: [dmUser2Id], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([workspaceId])
}

model Message {
  id               String    @id @default(uuid()) @db.Uuid
  channelId        String    @db.Uuid
  senderUserId     String    @db.Uuid
  body             String
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?
  replyToId        String?   @db.Uuid
  attachmentFileId String?   @db.Uuid
  isPinned         Boolean   @default(false)

  channel        Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  replyTo        Message?         @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]        @relation("MessageReplies")
  attachmentFile File?            @relation("MessageAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)
  reactions      MessageReaction[]

  @@index([channelId, createdAt])
  @@index([senderUserId])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Note {
  id            String                @id @default(uuid()) @db.Uuid
  workspaceId   String?               @db.Uuid
  ownerUserId   String                @db.Uuid
  title         String
  type          NoteType
  visibility    NoteVisibility        @default(WORKSPACE_SHARED)
  collaboration NoteCollaborationMode @default(SOLO)
  exportAccess  NoteExportAccess      @default(WORKSPACE_MEMBERS)
  sourceDevice  NoteSourceDevice      @default(WEB)
  storageType   NoteStorageType       @default(JSON)
  contentJson   Json?
  contentFileId String?               @unique @db.Uuid
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  contentFile File?      @relation("NoteContentFile", fields: [contentFileId], references: [id], onDelete: SetNull)

  collaborators NoteCollaborator[]
  artifacts     MeetingArtifact[]

  @@index([workspaceId])
  @@index([ownerUserId])
}

model NoteCollaborator {
  id         String         @id @default(uuid()) @db.Uuid
  noteId     String         @db.Uuid
  userId     String         @db.Uuid
  permission NotePermission
  createdAt  DateTime       @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([noteId, userId])
  @@index([userId])
}

model File {
  id               String         @id @default(uuid()) @db.Uuid
  workspaceId      String?        @db.Uuid
  uploadedByUserId String         @db.Uuid
  name             String
  mimeType         String
  sizeBytes        Int?
  visibility       FileVisibility @default(WORKSPACE_SHARED)
  isPinned         Boolean        @default(false)
  storageBucket    String?
  storageKey       String
  publicUrl        String?
  createdAt        DateTime       @default(now())

  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  uploadedBy User       @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  noteContentFor    Note?             @relation("NoteContentFile")
  artifacts         MeetingArtifact[]
  recordingFor      MeetingRecording?
  messageAttachments Message[]       @relation("MessageAttachment")

  @@index([workspaceId])
  @@index([uploadedByUserId])
}

model Meeting {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String?   @db.Uuid
  groupId            String?   @db.Uuid
  title              String
  description        String?
  startsAt           DateTime
  endsAt             DateTime?
  provider           String?
  providerMeetingId  String?
  meetingUrl         String?
  createdByUserId    String    @db.Uuid
  canceledAt         DateTime?
  canceledByUserId   String?   @db.Uuid
  cancellationReason String?
  seriesId           String?              @db.Uuid
  recurrence         RecurrenceFrequency?
  seriesIndex        Int?
  recurrenceEndsAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User       @relation("MeetingCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  participants        MeetingParticipant[]
  videoSessions       MeetingVideoSession[]
  artifacts           MeetingArtifact[]
  recordings          MeetingRecording[]
  channel             Channel?
  moderationSettings  MeetingModerationSettings?
  permissionOverrides MeetingPermissionOverride[]

  @@index([workspaceId, startsAt])
  @@index([groupId])
  @@index([createdByUserId])
  @@index([seriesId])
}

model MeetingModerationSettings {
  meetingId                 String  @id @db.Uuid
  sharedNotesDefaultEdit    Boolean @default(false)
  whiteboardDefaultEdit     Boolean @default(false)
  micDefaultEnabled         Boolean @default(true)
  cameraDefaultEnabled      Boolean @default(true)
  screenShareDefaultEnabled Boolean @default(false)
  reactionsEnabled          Boolean @default(true)
  handRaiseEnabled          Boolean @default(true)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model MeetingPermissionOverride {
  id              String                      @id @default(uuid()) @db.Uuid
  meetingId       String                      @db.Uuid
  userId          String                      @db.Uuid
  targetType      MeetingPermissionTargetType
  artifactId      String?                     @db.Uuid
  state           MeetingPermissionState
  grantedByUserId String?                     @db.Uuid
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  meeting   Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User             @relation("MeetingPermissionUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User?            @relation("MeetingPermissionGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  artifact  MeetingArtifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId, targetType, artifactId])
  @@index([meetingId, targetType])
  @@index([userId])
}

model MeetingParticipant {
  id            String                   @id @default(uuid()) @db.Uuid
  meetingId     String                   @db.Uuid
  userId        String                   @db.Uuid
  status        MeetingParticipantStatus @default(INVITED)
  joinedAt      DateTime?
  leftAt        DateTime?
  handRaisedAt  DateTime?
  handLoweredAt DateTime?
  createdAt     DateTime                 @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId])
  @@index([userId])
}

model MeetingVideoSession {
  id              String    @id @default(uuid()) @db.Uuid
  meetingId       String    @db.Uuid
  userId          String    @db.Uuid
  clientSessionId String
  connectedAt     DateTime  @default(now())
  disconnectedAt  DateTime?
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId, clientSessionId])
  @@index([meetingId, userId, disconnectedAt])
  @@index([userId])
}

model MeetingArtifact {
  id              String                @id @default(uuid()) @db.Uuid
  meetingId       String                @db.Uuid
  type            MeetingArtifactType
  source          MeetingArtifactSource @default(ATTACHED)
  noteId          String?               @db.Uuid
  fileId          String?               @db.Uuid
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now())

  meeting             Meeting                     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  note                Note?                       @relation(fields: [noteId], references: [id], onDelete: SetNull)
  file                File?                       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy           User                        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  permissionOverrides MeetingPermissionOverride[]

  @@index([meetingId])
  @@index([noteId])
  @@index([fileId])
}

model MeetingRecording {
  id              String                 @id @default(uuid()) @db.Uuid
  meetingId       String                 @db.Uuid
  egressId        String                 @unique
  status          MeetingRecordingStatus @default(STARTING)
  storageBucket   String
  storageKey      String
  fileId          String?                @unique @db.Uuid
  startedByUserId String                 @db.Uuid
  stoppedByUserId String?                @db.Uuid
  startedAt       DateTime               @default(now())
  stoppedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Int?
  errorMessage    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  file      File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  startedBy User    @relation("MeetingRecordingStarter", fields: [startedByUserId], references: [id], onDelete: Restrict)
  stoppedBy User?   @relation("MeetingRecordingStopper", fields: [stoppedByUserId], references: [id], onDelete: Restrict)

  @@index([meetingId, status])
  @@index([startedByUserId])
  @@index([stoppedByUserId])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  action      AuditAction
  actorUserId String?     @db.Uuid
  workspaceId String?     @db.Uuid
  targetId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  workspaceId String?          @db.Uuid
  actorUserId String?          @db.Uuid
  type        NotificationType
  title       String
  body        String?
  href        String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user      User       @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
}

model NotificationPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  announcements Boolean  @default(true)
  chatMessages  Boolean  @default(false)
  meetings      Boolean  @default(true)
  files         Boolean  @default(true)
  notes         Boolean  @default(true)
  soundEnabled  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Groups ────────────────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  meetings  Meeting[]

  @@index([workspaceId])
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

// ── Billing ───────────────────────────────────────────────────────────────────

model Organization {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  ownerUserId      String           @db.Uuid
  stripeCustomerId String?          @unique
  plan             SubscriptionPlan @default(FREE)
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  owner      User          @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  workspaces Workspace[]
  subscription Subscription?

  @@index([ownerUserId])
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String?            @unique @db.Uuid
  organizationId       String?            @unique @db.Uuid
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([stripeCustomerId])
}
